{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["react"],
  "rules": {
    "indent": ["error", 2],
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off"
  },
  "overrides": [
      {
          "files": ["webpack.config.js"],
          "env": { "node": true }, 
          "parserOptions": { "sourceType": "script" }
      }
  ]
}
